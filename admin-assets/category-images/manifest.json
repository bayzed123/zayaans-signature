{
  "version": 1,
  "purpose": "Fallback and category-card imagery for the live Zayaan’s Signature taxonomy.",
  "assets": {
    "womensWardrobe": "/zayaans-signature/images/catalogue/womens-wardrobe.jpg",
    "kidsFamily": "/zayaans-signature/images/catalogue/kids-family.jpg",
    "teensNewborn": "/zayaans-signature/images/catalogue/teens-newborn.jpg",
    "nargisusEthnic": "/zayaans-signature/images/catalogue/nargisus-ethnic.jpg",
    "dailyLife": "/zayaans-signature/images/catalogue/daily-life.jpg"
  },
  "rules": [
    { "whenSlugOrParentContains": ["nargisus"], "asset": "nargisusEthnic" },
    { "whenSlugOrParentContains": ["newborn", "teen"], "asset": "teensNewborn" },
    { "whenSlugOrParentContains": ["daily", "rainy", "sale"], "asset": "dailyLife" },
    { "whenSlugOrParentContains": ["kids", "mini-me"], "asset": "kidsFamily" },
    { "default": true, "asset": "womensWardrobe" }
  ]
}
